<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Billage" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color1</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="colorControlActivated">@color/G4</item> <!-- 커서 색상 -->
        <item name="android:windowLightStatusBar">true</item>   <!-- 상태바 아이콘(true: 검정 / false: 흰색) -->
        <item name="android:navigationBarColor">@android:color/transparent</item> <!-- 하단 탐색바 배경 -->
    </style>

    <style name="Theme.Billage" parent="Base.Theme.Billage" />

    <style name="AppTheme.NumberPicker" parent="Base.Theme.Billage">
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/G1</item>
    </style>
</resources>