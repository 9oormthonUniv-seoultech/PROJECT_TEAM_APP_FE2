<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LOGO">
        <item name="android:fontFamily">@font/pretendard_extra_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="head">
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="head2">
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="body_bold">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="body_semi_bold">
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="body">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="option">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="par">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="sub">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="times">
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="calendar">
        <item name="android:fontFamily">@font/pretendard_extra_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="navigation_bar">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <!-- 예약 관리 tag -->
    <style name="ReserveTag" parent="body">
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/color1</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>