<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login.LoginPwFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPw"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wh"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/imageButtonNavigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_navigation"
                android:background="@color/white"
                android:layout_marginStart="22dp"
                android:layout_gravity="start|center"
                android:foreground="?attr/selectableItemBackground"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/toolbar_registerPw"
                android:textColor="@color/G1"
                style="@style/head"/>
        </FrameLayout>

    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/frameLayoutPw"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarPw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editTextPw"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/background_edittext"
            android:hint="비밀번호"
            android:paddingHorizontal="22dp"
            android:inputType="textPassword"
            style="@style/body"
            />

        <ImageView
            android:id="@+id/imageViewPwEyeCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:src="@drawable/icon_eye_open"
            android:layout_margin="15dp"
            android:tag="0"
            style="@style/body"/>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/frameLayoutPwCondition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@id/frameLayoutPw"
        app:layout_constraintTop_toBottomOf="@id/frameLayoutPw"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textViewEnglishCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="영문 8~16자리"
            android:textColor="@color/G3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/frameLayoutPwCondition"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/par"/>

        <TextView
            android:id="@+id/textViewCharCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="특수문자 1개 이상 포함"
            android:textColor="@color/G3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewEnglishCondition"
            style="@style/par"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/frameLayoutPwCheck"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="76dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/frameLayoutPw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editTextPwCheck"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/background_edittext"
            android:paddingHorizontal="20dp"
            android:hint="비밀번호 확인"
            android:inputType="textPassword"
            style="@style/body"/>

        <ImageView
            android:id="@+id/imageViewPwCheckEyeCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:src="@drawable/icon_eye_open"
            android:layout_margin="15dp"
            android:tag="0"
            style="@style/body"/>

    </FrameLayout>

    <TextView
        android:id="@+id/textViewPwDoubleCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="동일한 비밀번호를 입력해주세요"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/frameLayoutPwCheck"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/G3"
        style="@style/par"/>

    <Button
        android:id="@+id/buttonPwNext"
        style="@style/body_bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:paddingVertical="12dp"
        android:backgroundTint="@drawable/background_login_button"
        android:foreground="?attr/selectableItemBackground"
        android:text="다음으로"
        android:textColor="@color/white"
        android:enabled="false"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>