<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/background_classroom_card_unselected"
    android:paddingHorizontal="13dp"
    android:paddingTop="11dp">


    <TextView
        android:id="@+id/textView_class_room"
        style="@style/head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="호실"
        android:textColor="@color/G1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView_class_room_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:text="호실 용도"
        android:textColor="@color/G1"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/textView_class_room" />

    <TextView
        android:id="@+id/textView_class_room_people"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="기준인원 0명"
        android:textColor="@color/G1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView_class_room" />

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        android:layout_marginRight="13dp"
        android:background="@color/G1"
        app:layout_constraintBottom_toBottomOf="@+id/textView_class_room_people"
        app:layout_constraintEnd_toStartOf="@+id/textView_class_room_people"
        app:layout_constraintTop_toTopOf="@+id/textView_class_room_people" />

    <include
        layout="@layout/time_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_class_room" />

</androidx.constraintlayout.widget.ConstraintLayout>