<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login.LoginEmailFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarEmail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wh"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/imageButtonNavigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_navigation"
                android:background="@color/white"
                android:layout_marginStart="22dp"
                android:layout_gravity="start|center"
                android:foreground="?attr/selectableItemBackground"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/toolbar_email"
                android:textColor="@color/G1"
                style="@style/head"/>
        </FrameLayout>

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/linearLayoutEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbarEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textViewEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학교 웹메일"
            android:textColor="@color/G1"
            style="@style/body_semi_bold"/>

        <LinearLayout
            android:id="@+id/linearLayoutAcceptButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            >

            <EditText
                android:id="@+id/editTextLoginId"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:paddingStart="22dp"
                android:background="@drawable/background_edittext"
                android:hint="example@seoultech.ac.kr..."
                android:inputType="textEmailAddress"
                android:textColor="@color/G3"
                android:layout_weight="3"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/body"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonAccept"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext_checked"
                android:text="인증하기"
                android:textColor="@color/color1"
                android:layout_weight="1"
                style="@style/body"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textViewAccept1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학적 인증을 위한 웹메일 인증이 필요합니다."
            android:textColor="@color/G3"
            style="@style/par"
            android:layout_marginStart="16dp"
            android:layout_marginTop="3dp"/>
        <TextView
            android:id="@+id/textViewAccept2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수신함을 확인해주세요!"
            android:textColor="@color/G3"
            style="@style/par"
            android:layout_marginStart="16dp"
            android:layout_marginTop="3dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutAccept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="86dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        >

        <TextView
            android:id="@+id/textViewAcceptCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증코드"
            android:textColor="@color/G1"
            style="@style/body_semi_bold"/>

        <LinearLayout
            android:id="@+id/linearLayoutCode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sign_certNum1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext"
                android:layout_weight="1"/>

            <EditText
                android:id="@+id/sign_certNum2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>

            <EditText
                android:id="@+id/sign_certNum3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>

            <EditText
                android:id="@+id/sign_certNum4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>

            <EditText
                android:id="@+id/sign_certNum5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>

            <EditText
                android:id="@+id/sign_certNum6"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/background_edittext"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textViewCodeInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증 코드를 입력해주세요"
            android:textColor="@color/G3"
            android:layout_marginTop="6dp"
            android:layout_marginStart="14dp"
            style="@style/par"/>

    </LinearLayout>

    <Button
        android:id="@+id/buttonEmailNext"
        style="@style/body_bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@drawable/background_login_button"
        android:enabled="false"
        android:foreground="?attr/selectableItemBackground"
        android:paddingVertical="12dp"
        android:text="다음으로"
        android:textColor="@color/white"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>