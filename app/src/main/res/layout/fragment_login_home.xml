<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Login.LoginHomeFragment"
    android:layout_gravity="center">

    <ImageView
        android:id="@+id/imageViewHomeLogo"
        android:layout_width="175dp"
        android:layout_height="175dp"
        android:layout_marginTop="110dp"
        android:src="@drawable/ic_launcher_foreground"
        android:background="#D9D9D9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="#D9D9D9"/>

    <TextView
        android:id="@+id/textViewId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="아이디(웹메일)"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/editTextLoginId"
        android:layout_marginHorizontal="30dp"/>

    <EditText
        android:id="@+id/editTextLoginId"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/edittext_login"
        android:layout_marginTop="45dp"
        app:layout_constraintTop_toBottomOf="@id/imageViewHomeLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="30dp"
        android:inputType="textEmailAddress"/>

    <TextView
        android:id="@+id/textViewPw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="비밀번호"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/editTextLoginPw"
        android:layout_marginHorizontal="30dp"/>

    <EditText
        android:id="@+id/editTextLoginPw"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/edittext_login"
        app:layout_constraintTop_toBottomOf="@id/editTextLoginId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="30dp"
        android:inputType="textPassword"/>

    <Button
        android:id="@+id/buttonLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인"
        android:backgroundTint="#B7C9FF"
        android:textColor="#35363E"
        android:fontFamily="@font/pretendard_font"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@id/editTextLoginPw"
        app:layout_constraintEnd_toEndOf="@id/editTextLoginPw"/>

    <LinearLayout
        android:id="@+id/linearLayoutForId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/buttonLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:id="@+id/linearLayoutForgetPw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/textViewForgetPw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호를 잊어버리셨나요?"
                />
            <TextView
                android:id="@+id/textViewFindPw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textview_find_pw"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/textViewFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="처음이라면?"
                />
            <TextView
                android:id="@+id/textViewRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textview_register"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutQA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginTop="150dp">

            <TextView
                android:id="@+id/textViewQA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="문의사항이 있다면?"/>

            <TextView
                android:id="@+id/textViewQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textview_question"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>