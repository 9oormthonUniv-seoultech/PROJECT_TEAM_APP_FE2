<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_reserve_card"
    android:padding="15dp"
    android:layout_marginTop="12dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Button
        android:id="@+id/textView_tag"
        style="@style/ReserveTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="예약 승인"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_detail1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_tag">

        <EditText
            android:id="@+id/editText_date"
            style="@style/option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:background="@drawable/background_edittext_reserve_detail"
            android:ems="10"
            android:inputType="text"
            android:paddingHorizontal="36dp"
            android:paddingVertical="10dp"
            android:text="2024/09/10(화)"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/editText_people"
            style="@style/option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="2"
            android:background="@drawable/background_edittext_reserve_detail"
            android:ems="10"
            android:inputType="text"
            android:paddingHorizontal="36dp"
            android:paddingVertical="10dp"
            android:text="인원"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="@+id/textView_tag"
            app:layout_constraintTop_toBottomOf="@+id/textView_tag" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_detail2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_detail1">

        <EditText
            android:id="@+id/editText_building"
            style="@style/option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:background="@drawable/background_edittext_reserve_detail"
            android:ems="10"
            android:inputType="text"
            android:paddingHorizontal="36dp"
            android:paddingVertical="10dp"
            android:text="건물명"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/editText_class_room"
            style="@style/option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="2"
            android:background="@drawable/background_edittext_reserve_detail"
            android:ems="10"
            android:inputType="text"
            android:paddingHorizontal="36dp"
            android:paddingVertical="10dp"
            android:text="호실"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="@+id/textView_tag"
            app:layout_constraintTop_toBottomOf="@+id/textView_tag" />

    </LinearLayout>

    <EditText
        android:id="@+id/editText_time"
        style="@style/option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:background="@drawable/background_edittext_reserve_detail"
        android:ems="10"
        android:inputType="text"
        android:paddingHorizontal="36dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="8dp"
        android:text="20:00 ~ 22:00"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_detail2" />

    <TextView
        android:id="@+id/textView_qna"
        style="@style/sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="문의"
        android:textColor="@color/G1"
        app:layout_constraintStart_toStartOf="@+id/editText_time"
        app:layout_constraintTop_toBottomOf="@+id/editText_time" />

    <TextView
        android:id="@+id/textView_cancel_reserve"
        style="@style/par"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="예약 취소"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editText_time" />


</androidx.constraintlayout.widget.ConstraintLayout>