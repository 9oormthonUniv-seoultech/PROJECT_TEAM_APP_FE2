<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".User.UserMapFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSelectDate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/linearLayoutWantPeople"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewSelectDate">

        <TextView
            android:id="@+id/textViewWantPeople"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="희망 인원"
            android:textColor="@color/G1"
            android:layout_marginStart="20dp"
            android:layout_marginVertical="12dp"
            style="@style/body_semi_bold"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/linearLayoutPeopleCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="20dp"
            android:gravity="center">

            <ImageButton
                android:id="@+id/imageButtonMinus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:src="@drawable/button_minus" />

            <TextView
                android:id="@+id/textViewPeopleCount"
                style="@style/option"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:text="0"
                android:textColor="@color/G1"
                android:layout_marginHorizontal="12.5dp"/>

            <ImageButton
                android:id="@+id/imageButtonPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:src="@drawable/button_plus" />
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/imageViewMap"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutWantPeople"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/icon_billage_logo"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSelectBuilding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="23.5dp"
        app:layout_constraintTop_toBottomOf="@id/imageViewMap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonMapNext"/>

    <Button
        android:id="@+id/buttonMapNext"
        style="@style/body_bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:paddingVertical="12dp"
        android:backgroundTint="@drawable/background_login_button"
        android:enabled="false"
        android:foreground="?attr/selectableItemBackground"
        android:text="다음으로"
        android:textColor="@color/white"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>